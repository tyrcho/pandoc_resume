<!DOCTYPE html>
<html lang="$lang$"$if(dir)$ dir="$dir$"$endif$>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes" />
$if(author-meta)$
  <meta name="author" content="$for(author-meta)$$author-meta$$sep$, $endfor$" />
$endif$
$if(date-meta)$
  <meta name="dcterms.date" content="$date-meta$" />
$endif$
$if(description-meta)$
  <meta name="description" content="$description-meta$" />
$endif$
  <title>$if(title-prefix)$$title-prefix$ - $endif$$if(title)$$title$$else$Resume$endif$</title>
  <link rel="stylesheet" href="css/resume.css" />
$for(header-includes)$
  $header-includes$
$endfor$
</head>
<body>
  <div class="download-links" aria-label="Resume downloads">
    <a href="resume.pdf">PDF</a>
    <a href="resume.docx">Word</a>
  </div>
$body$
</body>
</html>
